#!/usr/bin/env python3
# test stub for XSTREME: 8-mers most enriched in primary vs control (or vs shuffled) -> combined.meme + xstreme.tsv
import os, sys, random
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "bin"))
from collections import Counter
from memelib import Motif, write_meme
a = sys.argv[1:]
p = a[a.index("--p") + 1]; oc = a[a.index("--oc") + 1]; n = a[a.index("--n") + 1] if "--n" in a else None
def seqs(f): return [l.strip().upper() for l in open(f) if not l.startswith(">")]
P = seqs(p); N = seqs(n) if n else ["".join(random.sample(s, len(s))) for s in P]
tr = str.maketrans("ACGT", "TGCA")
def kc(S):
    c = Counter()
    for s in S:
        seen = set()
        for i in range(len(s) - 7):
            km = s[i:i + 8]; km = min(km, km[::-1].translate(tr)); seen.add(km)
        c.update(seen)
    return c
cp, cn = kc(P), kc(N)
sc = sorted(((cp[k] + 1) / (cn[k] * len(P) / max(1, len(N)) + 1), k) for k in cp if "N" not in k and cp[k] >= 5)[::-1][:3]
os.makedirs(oc, exist_ok=True)
def pwm(c): return [[0.85 if b == x else 0.05 for b in "ACGT"] for x in c]
ms = [Motif(f"{i+1}-{k}", f"STREME-{i+1}", pwm(k)) for i, (r, k) in enumerate(sc)]
write_meme(os.path.join(oc, "combined.meme"), ms)
with open(os.path.join(oc, "xstreme.tsv"), "w") as fh:
    fh.write("SEED_MOTIF\tRANK\tSOURCE\tID\tALT_ID\tCONSENSUS\tWIDTH\tSITES\tSEA_PVALUE\tEVALUE\tEVALUE_ACC\tSIM_SOURCE\tSIM_MOTIF\tMOTIF_URL\n")
    for i, (r, k) in enumerate(sc):
        fh.write(f"1\t{i+1}\tSTREME\t{i+1}-{k}\tSTREME-{i+1}\t{k}\t8\t{cp[k]}\t{10**-(3+r):.3g}\t{10**-(2+r):.3g}\tyes\t\t\t\n")
open(os.path.join(oc, "xstreme.html"), "w").write("<html></html>")
