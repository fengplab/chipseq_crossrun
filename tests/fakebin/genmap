#!/usr/bin/env python3
# test stub for GenMap: exact single-copy k-mers (both strands, 0 mismatches), bedGraph of 1/frequency
import os, sys
from collections import Counter
a = sys.argv[1:]
if a[0] == "index":
    fa = a[a.index("-F") + 1]; idx = a[a.index("-I") + 1]
    os.makedirs(idx); open(os.path.join(idx, "fasta_path"), "w").write(os.path.abspath(fa)); sys.exit(0)
k = int(a[a.index("-K") + 1]); idx = a[a.index("-I") + 1]; out = a[a.index("-O") + 1]
fa = open(os.path.join(idx, "fasta_path")).read().strip()
seqs, name = {}, None
for l in open(fa):
    l = l.strip()
    if l.startswith(">"): name = l[1:]; seqs[name] = []
    else: seqs[name].append(l.upper())
seqs = {n: "".join(v) for n, v in seqs.items()}
tr = str.maketrans("ACGT", "TGCA")
cnt = Counter()
for s in seqs.values():
    for i in range(len(s) - k + 1):
        km = s[i:i + k]; rc = km[::-1].translate(tr)
        cnt[min(km, rc)] += 1 if km != rc else 2
os.makedirs(out, exist_ok=True)
with open(os.path.join(out, os.path.basename(fa).rsplit(".", 1)[0] + ".genmap.bedgraph"), "w") as fh:
    for n, s in seqs.items():
        prev = None; start = 0
        for i in range(len(s) - k + 1):
            km = s[i:i + k]; v = 1.0 / cnt[min(km, km[::-1].translate(tr))]
            if v != prev:
                if prev is not None: fh.write(f"{n}\t{start}\t{i}\t{prev:.6g}\n")
                prev, start = v, i
        if prev is not None: fh.write(f"{n}\t{start}\t{len(s) - k + 1}\t{prev:.6g}\n")
