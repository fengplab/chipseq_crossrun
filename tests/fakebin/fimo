#!/usr/bin/env python3
# test stub: exact consensus matching (both strands) with IUPAC N as wildcard, FIMO --text format
import os
import sys, re
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "bin"))
from memelib import read_meme
args = [a for a in sys.argv[1:]]
if "--version" in args:
    print("5.5.9"); sys.exit(0)
# MEME Suite >= 5.5.4 parses "name::chrom:start-end" or "chrom:start-end" headers as genomic coordinates unless
# --no-pgc is given: the chromosome replaces the sequence name and positions become genomic. Mimicked here.
PGC = "--no-pgc" not in args
pgc_re = re.compile(r"^(?:.*::)?([^:\s]+):(\d+)-(\d+)$")
pos = []
i = 0
while i < len(args):
    if args[i] in ("--thresh", "--verbosity"): i += 2; continue
    if args[i].startswith("--"): i += 1; continue
    pos.append(args[i]); i += 1
meme, fa = pos[0], pos[1]
_, ms = read_meme(meme)
seqs = []; name = None; buf = []
for line in open(fa):
    line = line.strip()
    if line.startswith(">"):
        if name: seqs.append((name, "".join(buf)))
        name = line[1:]; buf = []
    else: buf.append(line.upper())
if name: seqs.append((name, "".join(buf)))
rc = str.maketrans("ACGTN", "TGCAN")
print("motif_id\tmotif_alt_id\tsequence_name\tstart\tstop\tstrand\tscore\tp-value\tq-value")
for m in ms:
    c = m.consensus().replace("N", ".")
    c = re.sub(r"[MRWSYK]", ".", c)
    pat = re.compile("(?=" + c + ")")
    r = c[::-1].translate(str.maketrans("ACGT.", "TGCA."))
    pat2 = re.compile("(?=" + r + ")")
    for n0, s in seqs:
        n, off = n0, 0
        mm0 = pgc_re.match(n0) if PGC else None
        if mm0:
            n, off = mm0.group(1), int(mm0.group(2))
        for mm in pat.finditer(s):
            print(f"{m.id}\t{m.alt}\t{n}\t{off+mm.start()+1}\t{off+mm.start()+m.width}\t+\t15\t1e-6\t")
        for mm in pat2.finditer(s):
            print(f"{m.id}\t{m.alt}\t{n}\t{off+mm.start()+1}\t{off+mm.start()+m.width}\t-\t15\t1e-6\t")
