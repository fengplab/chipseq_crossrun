#!/usr/bin/env python3
# test stub: fraction of sequences with consensus vs 5% baseline
import os
import sys, os, re, math
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "bin"))
from memelib import read_meme
a = sys.argv[1:]
p = a[a.index("--p")+1]
text = "--text" in a
oc = a[a.index("--oc")+1] if "--oc" in a else "sea_out"
if os.environ.get("FAKE_SEA_BROKEN_TEMPLATE") and not text:
    for _ in range(17): print("Bad file name.", file=sys.stderr)
    print("FATAL: Template does not contain data section.", file=sys.stderr); sys.exit(1)
dbs = [a[i+1] for i, x in enumerate(a) if x == "--m"]
seqs = [l.strip().upper() for l in open(p) if not l.startswith(">")]
if not text:
    os.makedirs(oc, exist_ok=True); open(os.path.join(oc, "sea.html"), "w").write("<html></html>")
rc = lambda s: s[::-1].translate(str.maketrans("ACGT", "TGCA"))
import contextlib
with (contextlib.nullcontext(sys.stdout) if text else open(os.path.join(oc, "sea.tsv"), "w")) as fh:
    fh.write("RANK\tDB\tID\tALT_ID\tCONSENSUS\tTP\tTP%\tFP\tFP%\tENR_RATIO\tSCORE_THR\tPVALUE\tLOG_PVALUE\tEVALUE\tLOG_EVALUE\tQVALUE\tLOG_QVALUE\n")
    r = 0
    for db in dbs:
        for m in read_meme(db)[1]:
            c = m.consensus()
            tp = sum(1 for s in seqs if c in s or rc(c) in s)
            n = len(seqs); fp = max(1, int(0.02 * n))
            if tp > 2 * fp:
                r += 1; pv = 10 ** (-min(300, tp - fp))
                fh.write(f"{r}\t{db}\t{m.id}\t{m.alt}\t{c}\t{tp}\t{100*tp/n:.2f}\t{fp}\t{100*fp/n:.2f}\t{(tp+1)/(fp+1):.2f}\t10\t{pv}\t0\t{pv}\t0\t{pv}\t0\n")
    fh.write("# stub\n")
