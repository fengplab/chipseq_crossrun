#!/usr/bin/env python3
# test stub: similarity = shared 6-mers between consensus strings (either strand)
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "bin"))
from memelib import read_meme
files = [a for a in sys.argv[1:] if a.endswith(".meme")]
q = read_meme(files[0])[1]
t = [m for f in files[1:] for m in read_meme(f)[1]]
rc = lambda s: s[::-1].translate(str.maketrans("ACGTN", "TGCAN"))
k = lambda s: {s[i:i+6] for i in range(len(s)-5)}
print("Query_ID\tTarget_ID\tOptimal_offset\tp-value\tE-value\tq-value\tOverlap\tQuery_consensus\tTarget_consensus\tOrientation")
for a in q:
    ca = a.consensus()
    for b in t:
        cb = b.consensus()
        sh = max(len(k(ca) & k(cb)), len(k(ca) & k(rc(cb))))
        if sh >= 2:
            e = 10 ** (-sh)
            print(f"{a.id}\t{b.id}\t0\t{e/100}\t{e}\t{e}\t8\t{ca}\t{cb}\t+")
print("# test stub")
