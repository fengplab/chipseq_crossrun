#!/usr/bin/env python3
# test stub for STREME --text: 8-mers most enriched in --p vs --n (or shuffled), MEME format on stdout
import os, sys, random
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "bin"))
from collections import Counter
from memelib import Motif, HEADER
a = sys.argv[1:]
assert "--text" in a and "--dna" in a, "stub expects --text --dna"
p = a[a.index("--p") + 1]; n = a[a.index("--n") + 1] if "--n" in a else None
def seqs(f): return [l.strip().upper() for l in open(f) if not l.startswith(">")]
P = seqs(p); N = seqs(n) if n else ["".join(random.sample(s, len(s))) for s in P]
tr = str.maketrans("ACGT", "TGCA")
def kc(S):
    c = Counter()
    for s in S:
        c.update({min(s[i:i+8], s[i:i+8][::-1].translate(tr)) for i in range(len(s) - 7)})
    return c
cp, cn = kc(P), kc(N)
sc = sorted(((cp[k] + 1) / (cn[k] * len(P) / max(1, len(N)) + 1), k) for k in cp if "N" not in k and cp[k] >= 5)[::-1][:3]
sys.stdout.write(HEADER.format(A=.25, C=.25, G=.25, T=.25))
for i, (r, k) in enumerate(sc):
    sys.stdout.write(Motif(f"{i+1}-{k}", f"STREME-{i+1}", [[0.85 if b == x else 0.05 for b in "ACGT"] for x in k], cp[k], f"{10**-(2+r):.2g}").to_meme())
